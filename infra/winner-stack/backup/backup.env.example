# Copy to backup.env on the production host. Do not commit real secrets.

# Restic target. Prefer a different provider/account than primary S3 buckets.
RESTIC_REPOSITORY=s3:https://s3.backup-provider.example/infra-backup
RESTIC_PASSWORD_COMMAND="pass show matrix/infra-restic"
# Alternative:
# RESTIC_PASSWORD_FILE=/root/.config/matrix-stack/restic-password

# PostgreSQL. Use either a container or direct host connection.
POSTGRES_CONTAINER=matrix-postgres
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DATABASES="synapse nextcloud"

# Local config roots to include in encrypted backups.
MDAD_BASE_PATH=/matrix
NEXTCLOUD_COMPOSE_DIR=/opt/nextcloud
BEEPER_PROXY_DIR=/opt/beeper-matrix-proxy
MATRIX_ARCHIVE_DIR=/opt/matrix-archive

# Optional S3 inventory checks. These do not copy whole buckets by default; they
# record bucket listings/counts so restore drills can detect missing providers.
AWS_PROFILE=matrix-stack-backup
MATRIX_MEDIA_BUCKET=matrix-media
NEXTCLOUD_PRIMARY_BUCKET=nextcloud-primary

# Retention policy. Set RESTIC_FORGET=false to disable pruning.
RESTIC_FORGET=true
RESTIC_KEEP_DAILY=14
RESTIC_KEEP_WEEKLY=8
RESTIC_KEEP_MONTHLY=12

# Safety.
BACKUP_STAGING_ROOT=/var/tmp/matrix-stack-backup
BACKUP_KEEP_STAGING=false
