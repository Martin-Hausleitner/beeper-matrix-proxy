# Copy to .env on the host. Do not commit real values.

NEXTCLOUD_HOSTNAME=cloud.example.tld
TRAEFIK_NETWORK=matrix-traefik

NEXTCLOUD_IMAGE=nextcloud:apache
NEXTCLOUD_CONTAINER_NAME=nextcloud
NEXTCLOUD_TRUSTED_PROXIES=172.16.0.0/12
NEXTCLOUD_TRUSTED_DOMAINS=cloud.example.tld
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME

POSTGRES_HOST=matrix-postgres
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=CHANGE_ME

REDIS_HOST=nextcloud-redis
REDIS_PASSWORD=CHANGE_ME

S3_BUCKET=nextcloud-primary
S3_HOST=s3.example-provider.tld
S3_REGION=eu-central
S3_KEY=CHANGE_ME
S3_SECRET=CHANGE_ME
S3_USE_SSL=true
S3_USE_PATH_STYLE=true
