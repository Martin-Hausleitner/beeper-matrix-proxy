CHATWOOT_PORT=3080
CHATWOOT_MAILPIT_WEB_PORT=8025
CHATWOOT_MAILPIT_SMTP_PORT=1025
CHATWOOT_ENV_FILE=${HOME}/Library/Application Support/openclaw-chatwoot-local/.env
CHATWOOT_POSTGRES_PASSWORD=change-me
SECRET_KEY_BASE=change-me
FRONTEND_URL=http://127.0.0.1:3080
FORCE_SSL=false
ENABLE_ACCOUNT_SIGNUP=true
REDIS_URL=redis://:change-me@redis:6379
REDIS_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=change-me
RAILS_ENV=production
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
ACTIVE_STORAGE_SERVICE=local
MAILER_SENDER_EMAIL=OpenClaw Chatwoot <chatwoot-local@openclaw.local>
SMTP_DOMAIN=openclaw.local
SMTP_ADDRESS=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=
SMTP_ENABLE_STARTTLS_AUTO=false
SMTP_OPENSSL_VERIFY_MODE=none
RAILS_INBOUND_EMAIL_SERVICE=relay
RAILS_INBOUND_EMAIL_PASSWORD=change-me
CHATWOOT_ADMIN_EMAIL=openclaw-chatwoot-local@example.local
CHATWOOT_ADMIN_PASSWORD=change-me-with-a-special-character
